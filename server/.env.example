# ─────────────────────────────────────────────────────────────────────────────
# UrbanNook Storefront — server env template (reference only)
#
# This file only documents which keys exist — it is NOT loaded by the app.
# Real values live in Infisical (see scripts/README-env-sync.md). `npm run
# dev`/`start` fetch them live via `infisical run`; no local .env file should
# exist on disk for development/staging. Never fill this file in and commit it.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=
PORT=
WHITE_LIST_CLIENT_URI=

# ── Database ─────────────────────────────────────────────────────────────────
DB_URI=
DB_NAME=

# ── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_ACCESS_TOKEN_SECRET=
USER_ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
GOOGLE_CLIENT_ID=
MASTER_PASSWORD=
DEFAULT_NFC_USER_PASSWORD=

# ── Email (Zoho SMTP) ────────────────────────────────────────────────────────
ZOHO_ADMIN_EMAIL=
ZOHO_SMTP_SECRET=
ZOHO_WEBHOOK_TOKEN=
EMAIL_ASSET_LOGO=
EMAIL_ASSET_DARK_LOGO=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
RP_KEY_ID=
RP_SECRET=
RP_WEBHOOK_SECRET=

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET=
AWS_BUCKET_REGION=
AWS_BUCKET_NAME=
AWS_CDN_BASE_URL=
AWS_S3_INVOICE_BUCKET=

# ── Maps (Ola Maps) ──────────────────────────────────────────────────────────
OLA_MAP_AUTO_COMPLETE_URL=
OLA_MAP_ADDRESS_SUGGESTION_URL=
OLA_MAP_API_KEY=

# ── Shipping (Shipmozo) ──────────────────────────────────────────────────────
SHIPMOZO_BASE_URL=
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
SHIPMOZO_DEFAULT_WAREHOUSE_ID=
SHIPMOZO_FALLBACK_NAME=
SHIPMOZO_FALLBACK_PHONE=

# ── Misc ──────────────────────────────────────────────────────────────────────
WAITLIST_COUPON_CODE=
LAMP_ID=
