# ─────────────────────────────────────────────────────────────────────────────
# UrbanNook Storefront — client (Vite) env template (reference only)
#
# This file only documents which keys exist — it is NOT loaded by Vite for
# real values. Real values live in Infisical (see scripts/README-env-sync.md).
# `npm run dev`/`dev:staging`/`build*` fetch them live via `infisical run`;
# no local .env file should exist on disk for development/staging. Never
# fill this file in and commit it.
# ─────────────────────────────────────────────────────────────────────────────

VITE_APP_ENV=
VITE_API_BASE_URL=
VITE_DOMAIN_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

# ── Staging/production-only extras ───────────────────────────────────────────
VITE_SPECIAL_PRODUCT_ID=
VITE_OFFER_END_DATE=
VITE_GTM_ID=
VITE_ENABLE_ANALYTICS=
VITE_META_PIXEL_ID=
